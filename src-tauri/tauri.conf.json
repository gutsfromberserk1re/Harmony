{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harmony",
  "version": "1.0.0",
  "identifier": "com.kiyokumo.harmony",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Harmony",
        "width": 820,
        "height": 500,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Kiyo Kumo Ltd.",
    "shortDescription": "Harmony - YouTube playlist audio player",
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/deno"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "startMenuFolder": "Harmony",
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "resources/": ""
    }
  }
}
